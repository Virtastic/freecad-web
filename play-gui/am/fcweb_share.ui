<!-- The "Sharing" preferences page. Plain Qt widgets: the page is a Python class
     (fcweb_share.FcwebSharingPage) that loads this file, reads and writes the FCWeb/Sharing
     parameters itself, and refreshes the status line from what the browser half reports.
     Buttons act immediately (Start, Stop, Copy, Regenerate, the AI toggle); the text
     fields apply on OK or on Start. Nothing here is a Gui::Pref* widget: those would
     persist the passwords into user.cfg, which is a file the session publishes. -->
<ui version="4.0">
 <class>FcwebSharing</class>
 <widget class="QWidget" name="FcwebSharing">
  <property name="windowTitle"><string>General</string></property>
  <layout class="QVBoxLayout" name="outer">
   <item>
    <widget class="QGroupBox" name="gbShare">
     <property name="title"><string>Share this session</string></property>
     <layout class="QFormLayout" name="fShare">
      <item row="0" column="0" colspan="2">
       <widget class="QLabel" name="lStatus">
        <property name="text"><string>Not shared</string></property>
        <property name="wordWrap"><bool>true</bool></property>
        <property name="styleSheet"><string>font-weight: bold;</string></property>
       </widget>
      </item>
      <item row="1" column="0" colspan="2">
       <layout class="QHBoxLayout" name="hStart">
        <item>
         <widget class="QPushButton" name="btnStart">
          <property name="text"><string>Start sharing</string></property>
          <property name="toolTip"><string>Share the active document as a link. Starts right away; OK is not needed.</string></property>
         </widget>
        </item>
        <item>
         <widget class="QPushButton" name="btnStop">
          <property name="text"><string>Stop sharing</string></property>
          <property name="toolTip"><string>End the session. The link stops working for everyone.</string></property>
          <property name="enabled"><bool>false</bool></property>
         </widget>
        </item>
        <item>
         <spacer name="hsStart"><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer>
        </item>
       </layout>
      </item>
      <item row="2" column="0"><widget class="QLabel" name="lName"><property name="text"><string>Your name</string></property></widget></item>
      <item row="2" column="1">
       <widget class="QLineEdit" name="leName">
        <property name="placeholderText"><string>Shown to others as “… is editing”</string></property>
        <property name="maxLength"><number>32</number></property>
       </widget>
      </item>
      <item row="3" column="0"><widget class="QLabel" name="lLink"><property name="text"><string>Share link</string></property></widget></item>
      <item row="3" column="1">
       <layout class="QHBoxLayout" name="hLink">
        <item>
         <widget class="QLineEdit" name="leLink">
          <property name="readOnly"><bool>true</bool></property>
          <property name="placeholderText"><string>Appears here when sharing starts</string></property>
         </widget>
        </item>
        <item>
         <widget class="QPushButton" name="btnCopyLink">
          <property name="text"><string>Copy</string></property>
          <property name="enabled"><bool>false</bool></property>
         </widget>
        </item>
       </layout>
      </item>
      <item row="4" column="0"><widget class="QLabel" name="lEditorL"><property name="text"><string>Editing now</string></property></widget></item>
      <item row="4" column="1"><widget class="QLabel" name="lEditor"><property name="text"><string>—</string></property></widget></item>
      <item row="5" column="0" colspan="2">
       <widget class="QCheckBox" name="cbEnv">
        <property name="text"><string>Include my settings, add-ons and macros (so it opens exactly as it does here)</string></property>
        <property name="checked"><bool>true</bool></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="gbAccess">
     <property name="title"><string>Who can open it</string></property>
     <layout class="QFormLayout" name="fAccess">
      <item row="0" column="0"><widget class="QLabel" name="lVpw"><property name="text"><string>Viewer password</string></property></widget></item>
      <item row="0" column="1">
       <layout class="QHBoxLayout" name="hVpw">
        <item>
         <widget class="QLineEdit" name="leViewerPw">
          <property name="echoMode"><enum>QLineEdit::Password</enum></property>
          <property name="placeholderText"><string>Type to set or change</string></property>
         </widget>
        </item>
        <item><widget class="QLabel" name="lVpwState"><property name="text"><string>not set</string></property></widget></item>
        <item>
         <widget class="QPushButton" name="btnClearVpw">
          <property name="text"><string>Clear</string></property>
          <property name="enabled"><bool>false</bool></property>
         </widget>
        </item>
       </layout>
      </item>
      <item row="1" column="0" colspan="2">
       <widget class="QLabel" name="lVpwNote">
        <property name="text"><string>Without one, anyone with the link can view.</string></property>
        <property name="styleSheet"><string>color: gray;</string></property>
       </widget>
      </item>
      <item row="2" column="0"><widget class="QLabel" name="lEpw"><property name="text"><string>Editor password</string></property></widget></item>
      <item row="2" column="1">
       <layout class="QHBoxLayout" name="hEpw">
        <item>
         <widget class="QLineEdit" name="leEditorPw">
          <property name="echoMode"><enum>QLineEdit::Password</enum></property>
          <property name="placeholderText"><string>Type to set or change</string></property>
         </widget>
        </item>
        <item><widget class="QLabel" name="lEpwState"><property name="text"><string>not set</string></property></widget></item>
        <item>
         <widget class="QPushButton" name="btnClearEpw">
          <property name="text"><string>Clear</string></property>
          <property name="enabled"><bool>false</bool></property>
         </widget>
        </item>
       </layout>
      </item>
      <item row="3" column="0" colspan="2">
       <widget class="QLabel" name="lEpwNote">
        <property name="text"><string>Anyone in the session can ask you for control. The editor password lets someone take it without asking.</string></property>
        <property name="wordWrap"><bool>true</bool></property>
        <property name="styleSheet"><string>color: gray;</string></property>
       </widget>
      </item>
      <item row="4" column="0"><widget class="QLabel" name="lExp"><property name="text"><string>Link expires</string></property></widget></item>
      <item row="4" column="1">
       <layout class="QHBoxLayout" name="hExp">
        <item>
         <widget class="QComboBox" name="cbExpiry">
          <item><property name="text"><string>Never (until I stop sharing)</string></property></item>
          <item><property name="text"><string>7 days from now</string></property></item>
          <item><property name="text"><string>30 days from now</string></property></item>
          <item><property name="text"><string>90 days from now</string></property></item>
         </widget>
        </item>
        <item><widget class="QLabel" name="lExpires"><property name="text"><string></string></property></widget></item>
       </layout>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <spacer name="vs"><property name="orientation"><enum>Qt::Vertical</enum></property></spacer>
   </item>
  </layout>
 </widget>
</ui>
