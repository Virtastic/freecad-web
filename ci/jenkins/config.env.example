# Copy to ci/jenkins/config.env (gitignored) and fill in, OR supply these as env in a Jenkins job.
# Precedence: environment > config.env > defaults.

# --- GitHub release fetch ------------------------------------------------------------------
# A token with read access to this private repo (the Jenkins job injects the github-virtastic
# credential; for the manual flow, export a PAT). Used only to download release assets.
GH_TOKEN=""
REPO="Virtastic/freecad-web"
# Pin a release tag, or leave empty for the latest release.
RELEASE_TAG=""

# --- test/app server -----------------------------------------------------------------------
TEST_HOST="testapp@192.168.1.131"
SSH_KEY="$HOME/.ssh/id_ed25519"
# Published host port for the freecad-test container. ja2=8081, jk2=8082, jka=8083, freecad=8084.
PORT="8084"

# --- deployed origin -----------------------------------------------------------------------
SMOKE_URL="https://freecad.dev.virtastic.app"
