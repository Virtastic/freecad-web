+void SoFCSelectionRoot::checkSelection(bool &sel, SbColor &selColor, bool &hl, SbColor &hlColor) {
+    sel = false;
+    hl = false;
+    if((sel = !SelColorStack.empty()))
+        selColor = SelColorStack.back();
+    if((hl = !HlColorStack.empty()))
+        hlColor = HlColorStack.back();
+}
