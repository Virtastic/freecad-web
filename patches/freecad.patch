-bool SoFCSelectionRoot::StackComp::operator()(const Stack &a, const Stack &b) const {
-    if(a.size()-a.offset < b.size()-b.offset)
-        return true;
-    if(a.size()-a.offset > b.size()-b.offset)
-        return false;
-    auto it1=a.rbegin(), end1=a.rend()-a.offset;
-    auto it2=b.rbegin();
-    for(;it1!=end1;++it1,++it2) {
-        if(*it1 < *it2)
-            return true;
-        if(*it1 > *it2)
-            return false;
-    }
-    return false;
-}
