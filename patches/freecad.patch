+def _fcweb_gmsh():
+    """The in-browser gmsh bridge, or None when running normally.
+
+    FreeCAD-Web has no fork/exec, so the gmsh binary is replaced by a wasm module
+    reached through the _fcwebgmsh builtin. Everything below falls back to the usual
+    binary when this returns None, so desktop behaviour is untouched.
+    """
+    try:
