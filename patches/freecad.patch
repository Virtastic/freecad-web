-        setDisplayMaskMode("Shaded");
-    else if ( strcmp("Wireframe",ModeName)==0 )
-        setDisplayMaskMode("Wireframe");
-    else if ( strcmp("Points",ModeName)==0 )
-        setDisplayMaskMode("Point");
-
-    ViewProviderGeometryObject::setDisplayMode( ModeName );
-}
