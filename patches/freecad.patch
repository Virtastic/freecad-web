-int SoFCSelectionRoot::SelContext::merge(int status, SoFCSelectionContextBasePtr &output,
-        SoFCSelectionContextBasePtr input, SoNode *)
-{
-    auto ctx = std::dynamic_pointer_cast<SelContext>(input);
-    if(ctx && ctx->hideAll) {
-        output = ctx;
-        return -1;
-    }
-    return status;
-}
