-        if((hlPushed = ctx->hlAll))
-            HlColorStack.push_back(ctx->hlColor);
-
-        if(inPath)
-            SoSeparator::GLRenderInPath(action);
-        else
-            SoSeparator::GLRenderBelowPath(action);
-
-        if(selPushed) {
