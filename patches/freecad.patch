+void SelectionView::toPython()
+{
+    QListWidgetItem* item = selectionView->currentItem();
+    if (!item) {
+        return;
+    }
+    QStringList elements = item->data(Qt::UserRole).toStringList();
+    if (elements.size() < 2) {
