-bool PythonConsole::isComment(const QString& source) const
-{
-    if (source.isEmpty()) {
-        return false;
-    }
-    int i=0;
-    while (i < source.length()) {
-        QChar ch = source.at(i++);
-        if (ch.isSpace()) {
-            continue;
-        }
-        else if (ch == QLatin1Char('#')) {
-            return true;
-        }
-        else {
-            return false;
-        }
-    }
-
-    return false;
-}
