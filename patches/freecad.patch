+class Redirection
+{
+public:
+    Redirection(FILE* f)
+        : fi(Base::FileInfo::getTempFileName())
+        , file(f)
+    {
+#ifdef WIN32
+        FILE* ptr = _wfreopen(fi.toStdWString().c_str(), L"w", file);
+#else
+        FILE* ptr = freopen(fi.filePath().c_str(), "w", file);
+#endif
+        if (!ptr) {
+            std::cerr << "Failed to reopen file" << std::endl;
+        }
+    }
+    ~Redirection()
+    {
+        fclose(file);
+        fi.deleteFile();
+    }
+
+private:
+    Base::FileInfo fi;
+    FILE* file;
+};
