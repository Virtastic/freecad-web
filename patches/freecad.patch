+
+    pcTransform->setMatrix(SbMatrix(dMtrx[0], dMtrx[1], dMtrx[2],  dMtrx[3],
+                                    dMtrx[4], dMtrx[5], dMtrx[6],  dMtrx[7],
+                                    dMtrx[8], dMtrx[9], dMtrx[10], dMtrx[11],
+                                    dMtrx[12],dMtrx[13],dMtrx[14], dMtrx[15]));
+}
