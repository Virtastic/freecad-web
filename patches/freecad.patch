+class _FcwebGmshProcess(QtCore.QObject):
+    """Stands in for the QProcess that compute() would normally return.
+
+    femtaskpanels/base_femmeshtaskpanel.py connects to started/finished/
+    readyReadStandardOutput/readyReadStandardError and reads the output with
+    readAllStandardOutput/Error, so the shim carries the same surface. The mesh itself
+    is produced synchronously (the wasm call suspends the interpreter via JSPI and
+    resumes when the module is done), then `finished` is emitted.
+    """
+
+    started = QtCore.Signal()
+    finished = QtCore.Signal(int, int)
+    readyReadStandardOutput = QtCore.Signal()
+    readyReadStandardError = QtCore.Signal()
+
+    def __init__(self, tool):
+        super().__init__()
+        self._tool = tool
+        self._out = b""
+        self._err = b""
+
+    def start(self):
+        QtCore.QTimer.singleShot(0, self._run)
+        return self
+
+    def _run(self):
+        self.started.emit()
+        rc = 1
+        try:
+            err = self._tool.run_gmsh_with_geo()
+            rc = 1 if getattr(self._tool, "error", False) else 0
+            if err:
+                self._err = err.encode("utf-8", "replace")
+                self.readyReadStandardError.emit()
+        except Exception as e:
+            self._err = f"{e}\n".encode("utf-8", "replace")
+            self.readyReadStandardError.emit()
+        # QProcess.NormalExit == 0
+        self.finished.emit(rc, 0)
+
+    # -- the bits the panel calls on the returned object --------------------
+    def readAllStandardOutput(self):
+        out, self._out = self._out, b""
+        return out
+
+    def readAllStandardError(self):
+        err, self._err = self._err, b""
+        return err
+
+    def state(self):
+        return 0  # QProcess.NotRunning
+
+    def waitForFinished(self, msecs=-1):
+        return True
+
+    def kill(self):
+        pass
+
+    terminate = kill
+
