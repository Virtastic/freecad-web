+#include <emscripten.h>
+#include <Base/Interpreter.h>
+extern "C" EMSCRIPTEN_KEEPALIVE void fcweb_run_python(const char* code) {
+    try {
+        Base::Interpreter().runString(code);
+    } catch (const Base::Exception& e) {
+        fprintf(stderr, "[fcweb_run_python] Base::Exception: %s\n", e.what());
+        fflush(stderr);
+    } catch (const std::exception& e) {
+        fprintf(stderr, "[fcweb_run_python] std::exception: %s\n", e.what());
+        fflush(stderr);
+    } catch (...) {
+        fprintf(stderr, "[fcweb_run_python] unknown exception\n");
+        fflush(stderr);
+    }
