                                 "#QCoreApplication.CodecForTr=0\n"
                                 "#QCoreApplication.UnicodeUTF8=1\n")
+    # Qt for WebAssembly has no subprocess support, so PySide's QtCore ships no
+    # QProcess. Several FEM/mesh modules do `from PySide.QtCore import QProcess`
+    # at import time; without a symbol that raises ImportError and spams the log.
+    # Provide an importable, inert stub (running a process is impossible in the
+    # browser and raises a clear RuntimeError only if actually invoked).
+    file(APPEND ${CMAKE_BINARY_DIR}/Ext/PySide/QtCore.py [==[
+
+try:
+    QProcess  # provided by a full Qt build
+except NameError:
+    from enum import IntEnum as _IntEnum
+
+    class QProcess(QObject):
+        """Inert QProcess stub for the Qt-for-WebAssembly build (no subprocess)."""
+
+        class ProcessState(_IntEnum):
+            NotRunning = 0
+            Starting = 1
+            Running = 2
+
+        class ExitStatus(_IntEnum):
+            NormalExit = 0
+            CrashExit = 1
+
+        class ProcessError(_IntEnum):
+            FailedToStart = 0
+            Crashed = 1
+            Timedout = 2
+            WriteError = 3
+            ReadError = 4
+            UnknownError = 5
+
+        NotRunning = ProcessState.NotRunning
+        Starting = ProcessState.Starting
+        Running = ProcessState.Running
+        NormalExit = ExitStatus.NormalExit
+        CrashExit = ExitStatus.CrashExit
+
+        def __init__(self, *args, **kwargs):
+            super().__init__(*args, **kwargs)
+            self._state = QProcess.ProcessState.NotRunning
+
+        def state(self):
+            return self._state
+
+        def _unavailable(self, *a, **k):
+            raise RuntimeError(
+                "QProcess is not available in the WebAssembly build "
+                "(the browser cannot launch external processes)")
+
+        # launching / waiting are genuinely impossible in wasm
+        start = startDetached = execute = _unavailable
+
+        def waitForStarted(self, *a, **k):
+            return False
+
+        def waitForFinished(self, *a, **k):
+            return False
+
+        def kill(self, *a, **k):
+            pass
+
+        terminate = kill
+
+        def readAll(self, *a, **k):
+            return QByteArray()
+
+        readAllStandardOutput = readAllStandardError = readAll
+
+        def exitCode(self):
+            return -1
+
+        def exitStatus(self):
+            return QProcess.ExitStatus.CrashExit
+
+        def setProgram(self, *a, **k):
+            pass
+
+        setArguments = setWorkingDirectory = setProcessEnvironment = setProgram
+]==])
     file(WRITE ${CMAKE_BINARY_DIR}/Ext/PySide/QtNetwork.py  "from PySide${PYSIDE_MAJOR_VERSION}.QtNetwork import *\n")
