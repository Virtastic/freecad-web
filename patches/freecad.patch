+bool ViewProviderDatum::onDelete(const std::vector<std::string> &)
+{
+    // TODO: Ask user what to do about dependent objects, e.g. Sketches that have this feature as their support
+    // 1. Delete
+    // 2. Suppress
+    // 3. Re-route
+
+    return true;
+}
