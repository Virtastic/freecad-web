+def _fcweb_resolve_font(fontfile):
+    """Resolve a ShapeString font path, falling back to a bundled font.
+
+    A .FCStd stores FontFile as an ABSOLUTE path from the machine that authored it (e.g.
+    "D:/BKG_Tmp/.../osifont-lgpl3fe.ttf"), which cannot exist elsewhere -- and in the
+    browser build there is no host filesystem to point it at, so the object just fails
+    with "Cannot open file" and goes Invalid. FreeCAD ships the fonts it needs, so prefer
+    the identically-named bundled font, then any bundled font, before giving up.
+    """
+    import os
+    import FreeCAD
+    if fontfile and os.path.exists(fontfile):
+        return fontfile
+    bundled = os.path.join(FreeCAD.getResourceDir(), "Mod", "TechDraw", "Resources", "fonts")
+    if not os.path.isdir(bundled):
+        return fontfile
+    if fontfile:
+        same = os.path.join(bundled, os.path.basename(fontfile))
+        if os.path.exists(same):
+            return same
+    for name in ("osifont-lgpl3fe.ttf", "osifont-italic.ttf"):
+        cand = os.path.join(bundled, name)
+        if os.path.exists(cand):
+            return cand
+    fonts = sorted(f for f in os.listdir(bundled) if f.lower().endswith((".ttf", ".otf")))
+    return os.path.join(bundled, fonts[0]) if fonts else fontfile
+
