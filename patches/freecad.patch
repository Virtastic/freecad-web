+void PropertyEditor::commitData(QWidget* editor)
+{
+    committing = true;
+    QTreeView::commitData(editor);
+    committing = false;
+    if (delaybuild) {
+        delaybuild = false;
+        propertyModel->buildUp(PropertyModel::PropertyList());
+    }
+}
