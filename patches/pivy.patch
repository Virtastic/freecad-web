    */
+  /*
+   * FCWEB: remember the answer per type name. The first query below asks for
+   * "<TypeName> *" ("SFVec3f *"), which no module has, and SWIG's own cache only
+   * remembers hits -- so every autocast (every getField, getChild, createInstance
+   * from Python) paid a linear scan of every type table before the 'So' retry
+   * succeeded: ~50 us a call on wasm, 25,000 calls and 1.35 s in one BIM document
+   * open. Type tables only grow, so a remembered hit stays right.
+   */
+  static std::map<std::string, swig_type_info *> fcweb_types;
+  const std::string fcweb_key(type_name, (size_t)type_len);
+  {
+    std::map<std::string, swig_type_info *>::const_iterator it = fcweb_types.find(fcweb_key);
+    if (it != fcweb_types.end()) { swig_type = it->second; }
+  }
+
+  if (!swig_type) {
   if (!(ptr_type = (char*)malloc(type_len+3))) { SWIG_fail; }
 
   memset(ptr_type, 0, type_len+3);
@@ -62,6 +80,8 @@
   }
 
   free(ptr_type);
+  fcweb_types[fcweb_key] = swig_type;
+  }
 
