+#ifdef __EMSCRIPTEN__
+  /* Coin resolves every GL entry point past the 1.1 core through a platform-specific
+     getprocaddress backend (WGL/EGL/GLX). None of those are compiled in for a wasm build,
+     so all three calls below return NULL and cc_dl_sym() has no library handle either --
+     meaning EVERY dynamically-resolved symbol came back NULL. Coin therefore concluded the
+     driver has no VBOs, no FBOs and no shaders, and fell back to the immediate-mode
+     glBegin/glVertex path, re-uploading all geometry to the GPU on every single frame.
+     emscripten resolves GL entry points by name via emscripten_GetProcAddress() (the same
+     resolver it exposes as eglGetProcAddress/glfwGetProcAddress in system/lib/gl/
+     libprocaddr.c), which is available whenever GL_ENABLE_GET_PROC_ADDRESS is on
+     (the default). */
+  {
+    extern void * emscripten_GetProcAddress(const char * name);
+    ptr = emscripten_GetProcAddress(symname);
+    if (ptr) goto returnpoint;
+  }
+#endif
+
   // FIXME: also supply 'glue' to coin_[x]gl_getprocaddress()
   ptr = coin_wgl_getprocaddress(glue, symname);
   if (ptr) goto returnpoint;
