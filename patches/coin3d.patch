-// Doc in parent.
+#if defined(__EMSCRIPTEN__)
+#include <vector>
+// Defined in the FreeCAD-Web harness (gl_legacy_stubs.c): draws text triangles
+// through the GL emulation's client-array path, bypassing the immediate-mode
+// batch assembly that corrupts these draws. See SoAsciiText::GLRender.
+extern "C" void fcwasm_draw_text_tris(const float * verts, int nverts);
+#endif
+
+// Reject glyph triangles whose (normalized, ~[0,1]) font-space coordinates are
+// non-finite or absurdly out of range. Guards against a wasm FreeType glyph
+// tessellator that occasionally emits stray vertices, which immediate-mode GL
+// emulation then paints as a screen-spanning fan. See call sites below.
+static inline SbBool
+coin_soascii_glyphtri_ok(const SbVec2f & a, const SbVec2f & b, const SbVec2f & c)
+{
+  const float LIMIT = 32.0f;
+  const SbVec2f * vv[3] = { &a, &b, &c };
+  for (int k = 0; k < 3; k++) {
+    const float x = (*vv[k])[0];
+    const float y = (*vv[k])[1];
+    if (x != x || y != y) { return FALSE; }              // NaN
+    if (x > LIMIT || x < -LIMIT || y > LIMIT || y < -LIMIT) { return FALSE; }  // +/-inf and out-of-range
+  }
+  return TRUE;
+}
