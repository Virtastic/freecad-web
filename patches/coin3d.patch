+  std::vector<GLfloat> fcwasm_tris;
+  fcwasm_tris.reserve(1024);
+  #define FCWASM_TEXT_VERTEX(vx, vy) fcwasm_tris.push_back(vx); fcwasm_tris.push_back(vy); fcwasm_tris.push_back(0.0f);
+#else
   glBegin(GL_TRIANGLES);
   glNormal3f(0.0f, 0.0f, 1.0f);
