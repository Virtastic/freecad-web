# Meson cross-file TEMPLATE for building Python C-extensions (numpy) to wasm64-emscripten.
#
# @ROOT@ is substituted with the repo root by tools/gen-crossfiles.sh, which every
# consumer runs before `meson setup`. Do not edit the generated
# emscripten-crossfile.meson -- it is gitignored and overwritten.
#
# Paths are absolute in the generated file so meson can be run from any build dir.
[binaries]
c = '@ROOT@/emsdk/upstream/emscripten/emcc'
cpp = '@ROOT@/emsdk/upstream/emscripten/em++'
ar = '@ROOT@/emsdk/upstream/emscripten/emar'
ranlib = '@ROOT@/emsdk/upstream/emscripten/emranlib'
strip = '@ROOT@/emsdk/upstream/bin/llvm-strip'
# host build python (runs numpy's code generators). Use the non-.exe symlink so
# meson doesn't mono-wrap it (it's a native binary despite CPython's naming).
python = '@ROOT@/deps/src/cpython/builddir/build/python3-native'

[host_machine]
system = 'emscripten'
cpu_family = 'wasm64'
cpu = 'wasm64'
endian = 'little'

# EXCEPTIONS. -fwasm-exceptions, not -fexceptions, because every other object in the
# FreeCAD link -- Qt, OCCT, Coin, CPython, FreeCAD itself, and now _ctypes and PIL -- uses
# wasm EH, and the two models cannot be mixed in one link. With -fexceptions here, numpy's
# two C++ archives referenced emscripten's JS-EH runtime and the link ended in
#     undefined symbol: __cxa_find_matching_catch_2 / __resumeException / llvm_eh_typeid_for
# named to no file at all. tools/check-eh-model.sh scanned 3891 objects and found exactly
# these two: libnpy__pocketfft_umath.a (pocketfft) and libhighway.a (Google Highway).
# SUPPORT_LONGJMP=wasm goes with it: wasm EH needs it for setjmp/longjmp.
[built-in options]
# -Wno-error=incompatible-pointer-types: numpy is told longdouble_format = IEEE_DOUBLE_LE
# below, i.e. long double has the same representation as double. dragon4.c relies on that,
# casting npy_longdouble* to npy_float64* on purpose. clang 20 (emsdk 6.0.9) promoted that
# warning to a hard error where the older clang in emsdk 3.1.70 only warned, which is the
# whole of the change -- not a wasm64 issue. Demote it back to a warning so the deliberate
# cast compiles; the low 8 bytes it reads ARE the value under IEEE_DOUBLE_LE.
c_args = ['-fwasm-exceptions', '-sSUPPORT_LONGJMP=wasm', '-pthread', '-O2', '-Wno-error=incompatible-pointer-types', '-I@ROOT@/deps/src/cpython/Include', '-I@ROOT@/deps/src/cpython/builddir/emscripten-mt']
cpp_args = ['-fwasm-exceptions', '-sSUPPORT_LONGJMP=wasm', '-pthread', '-O2', '-I@ROOT@/deps/src/cpython/Include', '-I@ROOT@/deps/src/cpython/builddir/emscripten-mt']
c_link_args = ['-fwasm-exceptions', '-sSUPPORT_LONGJMP=wasm', '-pthread']
cpp_link_args = ['-fwasm-exceptions', '-sSUPPORT_LONGJMP=wasm', '-pthread']

[properties]
needs_exe_wrapper = true
longdouble_format = 'IEEE_DOUBLE_LE'
