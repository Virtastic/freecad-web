[binaries]
c = '/Users/mstavridis/Downloads/FreeCAD-Web/emsdk/upstream/emscripten/emcc'
cpp = '/Users/mstavridis/Downloads/FreeCAD-Web/emsdk/upstream/emscripten/em++'
ar = '/Users/mstavridis/Downloads/FreeCAD-Web/emsdk/upstream/emscripten/emar'
ranlib = '/Users/mstavridis/Downloads/FreeCAD-Web/emsdk/upstream/emscripten/emranlib'
strip = '/Users/mstavridis/Downloads/FreeCAD-Web/emsdk/upstream/bin/llvm-strip'
python = '/Users/mstavridis/Downloads/FreeCAD-Web/deps/src/cpython/builddir/build/python3-native'

[host_machine]
system = 'emscripten'
cpu_family = 'wasm32'
cpu = 'wasm32'
endian = 'little'

[built-in options]
c_args = ['-fwasm-exceptions', '-pthread', '-O2', '-I/Users/mstavridis/Downloads/FreeCAD-Web/deps/src/cpython/Include', '-I/Users/mstavridis/Downloads/FreeCAD-Web/deps/src/cpython/builddir/emscripten-mt']
cpp_args = ['-fwasm-exceptions', '-pthread', '-O2', '-I/Users/mstavridis/Downloads/FreeCAD-Web/deps/src/cpython/Include', '-I/Users/mstavridis/Downloads/FreeCAD-Web/deps/src/cpython/builddir/emscripten-mt']
c_link_args = ['-fwasm-exceptions', '-pthread']
cpp_link_args = ['-fwasm-exceptions', '-pthread']

[properties]
needs_exe_wrapper = true
longdouble_format = 'IEEE_DOUBLE_LE'
numpy-include-dir = '/Users/mstavridis/Downloads/FreeCAD-Web/deps/src/numpy/numpy/_core/include'
devnull = '/dev/null'
