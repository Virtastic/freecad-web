# === Vendored toolchains (multi-GB, not source) ===
/emsdk/
/qt/
/deps/
/.qtvenv/
/toolchain/*/
!/toolchain/env.sh

# === Build directories ===
/build-coin/
/build-freecad/
/build-freecad-gui/
/build-occt/
/build-xercesc/
/build-yamlcpp/
/build-pivy-wasm/
/build-pyside-wasm/
/build-shiboken-gen/
/build-shiboken-wasm/

# === Install trees / web output ===
/freecad-install/
/freecad-gui-install/
/play/
# play-gui: track the hand-authored front-end (served by the deploy container),
# ignore the multi-hundred-MB build artifacts (shipped via GitHub Release instead).
/play-gui/*
!/play-gui/freecad-gui.html
!/play-gui/qtloader.js
# installability assets: hand-authored / generated once, shipped in the image
!/play-gui/manifest.webmanifest
!/play-gui/sw.js
!/play-gui/icon-192.png
!/play-gui/icon-512.png

# === Compiled artifacts ===
*.o
*.a
*.so
*.dylib
*.wasm
*.wasm.map

# spike build outputs (keep source: *.cpp *.mjs *.cjs *.sh CMakeLists.txt package.json)
spikes/**/build/
spikes/**/node_modules/
spikes/**/*.js
spikes/**/*.wasm

# === Logs ===
aqtinstall.log
*.log

# === OS / editor cruft ===
.DS_Store

# === Additional wasm dep build dirs (Wave 5+ / numpy) ===
/build-hdf5/
/build-vtk/
/build-ifcopenshell/
/build-numpy/
/node_modules/
scratchpad/vtktest/*.wasm
scratchpad/vtktest/*.js
scratchpad/vtktest/*.vtu
scratchpad/vtktest/*.log
scratchpad/fttest/*.wasm
scratchpad/fttest/*.js
scratchpad/fttest/*.ttf
scratchpad/fttest/*.err
build-matplotlib/

# terraform local state
*.tfstate
*.tfstate.*
.terraform/
tools/__pycache__/
