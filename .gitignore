# === Vendored toolchains (multi-GB, not source) ===
# emsdk* covers both pinned toolchains: emsdk (3.1.70, compiles/links) and
# emsdk2 (4.0.23, supplies wasm-opt only). See BUILD-WEH.md.
/emsdk*/
/qt/
/deps/
/.qtvenv/
/toolchain/*/
!/toolchain/env.sh

# === Build directories ===
# One glob rather than a hand-kept list: the enumerated form silently missed every
# -weh directory (build-freecad-gui-weh/ above all), so CMakeCache.txt and build.ninja
# — which embed absolute paths — were never ignored. Trailing slash matches directories
# only, so the build-*.sh scripts at the repo root stay tracked.
/build-*/
/weh-objs/

# === Install trees / web output ===
/freecad-install/
/freecad-gui-install/
/play/
# play-gui: track the hand-authored front-end (served by the deploy container),
# ignore the multi-hundred-MB build artifacts (shipped via GitHub Release instead).
/play-gui/*
!/play-gui/freecad-gui.html
!/play-gui/qtloader.js
# installability assets: hand-authored / generated once, shipped in the image
!/play-gui/manifest.webmanifest
!/play-gui/sw.js
!/play-gui/icon-192.png
!/play-gui/icon-512.png
# source of truth for the non-JSPI dialog-shim payload embedded in freecad-gui.html
!/play-gui/wasm_dialog_shim.py

# === Compiled artifacts ===
*.o
*.a
*.so
*.dylib
*.wasm
*.wasm.map

# spike build outputs (keep source: *.cpp *.mjs *.cjs *.sh CMakeLists.txt package.json)
spikes/**/build/
spikes/**/node_modules/
spikes/**/*.js
spikes/**/*.wasm

# === Logs ===
aqtinstall.log
*.log

# === OS / editor cruft ===
.DS_Store

# === Node / test scratch ===
/node_modules/

# Meson cross-files are GENERATED from the .meson.in templates by
# tools/gen-crossfiles.sh (they need absolute paths, which differ per machine).
/*.meson
!/*.meson.in
scratchpad/vtktest/*.wasm
scratchpad/vtktest/*.js
scratchpad/vtktest/*.vtu
scratchpad/vtktest/*.log
scratchpad/fttest/*.wasm
scratchpad/fttest/*.js
scratchpad/fttest/*.ttf
scratchpad/fttest/*.err

# === Python bytecode (stray .pyc files have been committed here before) ===
__pycache__/
*.pyc

# === OS / editor cruft ===
Thumbs.db
desktop.ini
*.swp
*~

# terraform local state
*.tfstate
*.tfstate.*
.terraform/
