# Meson cross-file for building Python C-extensions (numpy) to wasm32-emscripten.
# Paths are absolute so meson can be run from any build dir.
[binaries]
c = '/Users/mstavridis/Downloads/FreeCAD-Web/emsdk/upstream/emscripten/emcc'
cpp = '/Users/mstavridis/Downloads/FreeCAD-Web/emsdk/upstream/emscripten/em++'
ar = '/Users/mstavridis/Downloads/FreeCAD-Web/emsdk/upstream/emscripten/emar'
ranlib = '/Users/mstavridis/Downloads/FreeCAD-Web/emsdk/upstream/emscripten/emranlib'
strip = '/Users/mstavridis/Downloads/FreeCAD-Web/emsdk/upstream/bin/llvm-strip'
# host build python (runs numpy's code generators). Use the non-.exe symlink so
# meson doesn't mono-wrap it (it's a native macOS binary despite CPython's naming).
python = '/Users/mstavridis/Downloads/FreeCAD-Web/deps/src/cpython/builddir/build/python3-native'

[host_machine]
system = 'emscripten'
cpu_family = 'wasm32'
cpu = 'wasm32'
endian = 'little'

[built-in options]
c_args = ['-fexceptions', '-pthread', '-O2', '-I/Users/mstavridis/Downloads/FreeCAD-Web/deps/src/cpython/Include', '-I/Users/mstavridis/Downloads/FreeCAD-Web/deps/src/cpython/builddir/emscripten-mt']
cpp_args = ['-fexceptions', '-pthread', '-O2', '-I/Users/mstavridis/Downloads/FreeCAD-Web/deps/src/cpython/Include', '-I/Users/mstavridis/Downloads/FreeCAD-Web/deps/src/cpython/builddir/emscripten-mt']
c_link_args = ['-fexceptions', '-pthread']
cpp_link_args = ['-fexceptions', '-pthread']

[properties]
needs_exe_wrapper = true
longdouble_format = 'IEEE_DOUBLE_LE'
